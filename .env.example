# ─────────────────────────────────────────────────────────────
# CSVForge environment variables — TEMPLATE FILE
#
# WHAT IS .env?
#   A plain text file containing key=value pairs read by python-dotenv
#   at application startup. It's how you configure the application for
#   your local environment without hardcoding values in source code.
#
# HOW TO USE THIS FILE:
#   cp .env.example .env
#   Then fill in real values in .env (especially DATABASE_URL).
#
# WHY IS .env GITIGNORED?
#   .env can contain real credentials (database passwords, AWS keys).
#   Committing credentials to git is a serious security vulnerability:
#   - They become part of git history forever (even if later deleted)
#   - Anyone with repo access (now or in the future) can read them
#   - Credentials leaked in public repos are scanned by attackers within minutes
#
#   The .gitignore entry `/.env` prevents .env from ever being committed.
#   This file (.env.example) is the safe template — it contains placeholder
#   values and documents the expected format. It IS committed to git.
#
# THE .env.example PATTERN:
#   .env.example serves as documentation for new developers:
#     "here are all the variables the application expects, with explanations"
#   Without it, a new team member would have to read all the code to discover
#   what variables to set. With it, setup is: copy the file, fill in values.
#
# HOW THE APP READS THESE VALUES:
#   backend/db/connection.py calls load_dotenv() which reads .env and
#   adds each variable to os.environ. From that point, os.getenv("KEY")
#   works for any variable defined here.
#
# WHERE THESE VALUES ARE CONSUMED:
#   See backend/db/connection.py → _build_database_url() for the exact code
#   that reads ENVIRONMENT, DATABASE_URL, DB_SECRET_ARN, DB_HOST, DB_PORT,
#   and DB_NAME. The local vs production branching logic lives there.
#
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Runtime environment ───────────────────────────────────────
# Controls which database credential strategy the app uses.
#
# "local"      → DATABASE_URL is read directly from this file / environment.
#                This is the path for local development and CI.
#                No AWS calls are made.
#
# "production" → DB credentials are fetched from AWS Secrets Manager at
#                startup using DB_SECRET_ARN, DB_HOST, DB_PORT, DB_NAME.
#                DATABASE_URL is constructed at runtime; it is never stored.
#                (AD-16, AD-24 in docs/DECISIONS.md)
#
# CONSEQUENCE OF WRONG VALUE:
#   Setting ENVIRONMENT=production locally without AWS credentials will cause
#   the application to fail at startup trying to call Secrets Manager.
ENVIRONMENT=local

# ── Database (local development only) ────────────────────────
# Used when ENVIRONMENT=local.
#
# FORMAT: <dialect>+<driver>://<user>:<password>@<host>:<port>/<dbname>
#
# dialect: postgresql (the database type)
# driver:  psycopg    (psycopg 3 — the Python PostgreSQL adapter)
#          Note: psycopg2 would use `postgresql+psycopg2://`
#          The driver name in the URL must match the installed package.
# user:    database username (matches POSTGRES_USER in docker-compose.yml)
# password: database password (matches POSTGRES_PASSWORD in docker-compose.yml)
# host:    `localhost` when running the API directly (not in Docker)
#          `postgres`  when the API runs inside Docker Compose
#          (Docker's internal DNS resolves service names — see docker-compose.yml)
# port:    5432 is the default PostgreSQL port
# dbname:  the PostgreSQL database name (matches POSTGRES_DB in docker-compose.yml)
#
# CONSEQUENCE OF WRONG VALUE:
#   Wrong user/password → sqlalchemy.exc.OperationalError: authentication failed
#   Wrong host          → sqlalchemy.exc.OperationalError: connection refused
#   Wrong dbname        → sqlalchemy.exc.OperationalError: database does not exist
DATABASE_URL=postgresql+psycopg://csvforge:password@localhost:5432/csvforge

# ── Database (production — Lambda reads these at runtime) ─────
# The application uses these when ENVIRONMENT=production.
# Lambda's execution role must have secretsmanager:GetSecretValue permission
# on DB_SECRET_ARN.
#
# DB_SECRET_ARN: ARN of the Secrets Manager secret that stores the DB credentials.
#   The secret's value is a JSON object: {"username":"...","password":"..."}
#   Using a secret ARN (not the credentials themselves) means rotating the
#   password is done in Secrets Manager without changing application config.
DB_SECRET_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:csvforge-db-secret

# DB_HOST: the RDS instance endpoint hostname.
#   Stored separately from the Secrets Manager secret to avoid a circular
#   CloudFormation dependency (the RDS instance must exist before the secret
#   can reference it, but CloudFormation resolves references at stack creation).
#   See AD-24 in docs/DECISIONS.md.
DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com

# DB_PORT: PostgreSQL port. 5432 is the universal default.
DB_PORT=5432

# DB_NAME: the PostgreSQL database name on the RDS instance.
DB_NAME=csvforge

# ── AWS credentials (local dev / CI — not needed in Lambda) ──
# Lambda functions get AWS credentials automatically via their IAM execution role.
# For local development, set these explicitly.
# In CI/CD, inject them as environment variables (never commit real values here).
#
# CONSEQUENCE OF WRONG VALUE:
#   botocore.exceptions.NoCredentialsError: Unable to locate credentials
#   botocore.exceptions.ClientError: Access Denied
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_DEFAULT_REGION=us-east-1

# ── S3 (Day 2+) ───────────────────────────────────────────────
# The S3 bucket where CSV files are uploaded and processed results are stored.
# The bucket name must be globally unique across all AWS accounts.
# Format: csvforge-files-{environment} (dev/staging/prod)
#
# CONSEQUENCE OF WRONG VALUE:
#   boto3 will raise NoSuchBucket or access denied errors when uploading.
S3_BUCKET_NAME=csvforge-files-dev

# ── SQS (Day 2+) ─────────────────────────────────────────────
# The SQS queue URL where the API sends job messages for the worker to consume.
# Format: https://sqs.{region}.amazonaws.com/{account-id}/{queue-name}
#
# CONSEQUENCE OF WRONG VALUE:
#   boto3 will raise QueueDoesNotExist or access denied errors when enqueuing.
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/csv-jobs
