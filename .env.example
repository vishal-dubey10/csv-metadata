# ─────────────────────────────────────────────────────────────
# CSVForge environment variables — TEMPLATE FILE
#
# WHAT IS .env?
#   A plain text file containing key=value pairs read by python-dotenv
#   at application startup. It's how you configure the application for
#   your local environment without hardcoding values in source code.
#
# HOW TO USE THIS FILE:
#   cp .env.example .env
#   Then fill in real values in .env (especially DATABASE_URL).
#
# WHY IS .env GITIGNORED?
#   .env can contain real credentials (database passwords, AWS keys).
#   Committing credentials to git is a serious security vulnerability:
#   - They become part of git history forever (even if later deleted)
#   - Anyone with repo access (now or in the future) can read them
#   - Credentials leaked in public repos are scanned by attackers within minutes
#
#   The .gitignore entry `/.env` prevents .env from ever being committed.
#   This file (.env.example) is the safe template — it contains placeholder
#   values and documents the expected format. It IS committed to git.
#
# THE .env.example PATTERN:
#   .env.example serves as documentation for new developers:
#     "here are all the variables the application expects, with explanations"
#   Without it, a new team member would have to read all the code to discover
#   what variables to set. With it, setup is: copy the file, fill in values.
#
# HOW THE APP READS THESE VALUES:
#   backend/db/connection.py calls load_dotenv() which reads .env and
#   adds each variable to os.environ. From that point, os.getenv("KEY")
#   works for any variable defined here.
#
# WHERE THESE VALUES ARE CONSUMED:
#   See backend/db/connection.py → _build_database_url() for the exact code
#   that reads ENVIRONMENT, DATABASE_URL, DB_SECRET_ARN, DB_HOST, DB_PORT,
#   and DB_NAME. The local vs production branching logic lives there.
#
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────

# ── Runtime environment ───────────────────────────────────────
# Controls which database credential strategy the app uses.
#
# "local"      → DATABASE_URL is read directly from this file / environment.
#                This is the path for local development and CI.
#                No AWS calls are made.
#
# "production" → DB credentials are fetched from AWS Secrets Manager at
#                startup using DB_SECRET_ARN, DB_HOST, DB_PORT, DB_NAME.
#                DATABASE_URL is constructed at runtime; it is never stored.
#                (AD-16, AD-24 in docs/DECISIONS.md)
#
# CONSEQUENCE OF WRONG VALUE:
#   Setting ENVIRONMENT=production locally without AWS credentials will cause
#   the application to fail at startup trying to call Secrets Manager.
ENVIRONMENT=local

# ── Database (local development only) ────────────────────────
# Used when ENVIRONMENT=local.
#
# FORMAT: <dialect>+<driver>://<user>:<password>@<host>:<port>/<dbname>
#
# dialect: postgresql (the database type)
# driver:  psycopg    (psycopg 3 — the Python PostgreSQL adapter)
#          Note: psycopg2 would use `postgresql+psycopg2://`
#          The driver name in the URL must match the installed package.
# user:    database username (matches POSTGRES_USER in docker-compose.yml)
# password: database password (matches POSTGRES_PASSWORD in docker-compose.yml)
# host:    `localhost` when running the API directly (not in Docker)
#          `postgres`  when the API runs inside Docker Compose
#          (Docker's internal DNS resolves service names — see docker-compose.yml)
# port:    5432 is the default PostgreSQL port
# dbname:  the PostgreSQL database name (matches POSTGRES_DB in docker-compose.yml)
#
# CONSEQUENCE OF WRONG VALUE:
#   Wrong user/password → sqlalchemy.exc.OperationalError: authentication failed
#   Wrong host          → sqlalchemy.exc.OperationalError: connection refused
#   Wrong dbname        → sqlalchemy.exc.OperationalError: database does not exist
DATABASE_URL=postgresql+psycopg://csvforge:password@localhost:5432/csvforge

# ── Database (production — Lambda reads these at runtime) ─────
# The application uses these when ENVIRONMENT=production.
# Lambda's execution role must have secretsmanager:GetSecretValue permission
# on DB_SECRET_ARN.
#
# NOTE ON REGION: All CSVForge AWS resources use ap-south-1 (Mumbai) per AD-D2-01.
# The us-east-1 region shown in the placeholder ARNs below is a placeholder only —
# replace with your actual ARNs which will use ap-south-1.
#
# DB_SECRET_ARN: ARN of the Secrets Manager secret that stores the DB credentials.
#   The secret's value is a JSON object: {"username":"...","password":"..."}
#   Using a secret ARN (not the credentials themselves) means rotating the
#   password is done in Secrets Manager without changing application config.
#   Created by the CloudFormation data.yaml or api.yaml stack.
DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:123456789012:secret:csvforge-db-secret

# DB_HOST: the RDS instance endpoint hostname.
#   Stored separately from the Secrets Manager secret to avoid a circular
#   CloudFormation dependency (the RDS instance must exist before the secret
#   can reference it, but CloudFormation resolves references at stack creation).
#   See AD-24 in docs/DECISIONS.md.
#   Obtain from: aws rds describe-db-instances --region ap-south-1
DB_HOST=your-rds-endpoint.ap-south-1.rds.amazonaws.com

# DB_PORT: PostgreSQL port. 5432 is the universal default.
DB_PORT=5432

# DB_NAME: the PostgreSQL database name on the RDS instance.
DB_NAME=csvforge

# ── AWS region ────────────────────────────────────────────────
# All CSVForge AWS resources are deployed in ap-south-1 (Mumbai) per AD-D2-01.
# Do NOT change this to us-east-1 — that would create cross-region latency
# and potential data residency issues if your resources are in ap-south-1.
#
# Lambda functions use the execution role's implicit credentials (no keys needed).
# For local development, set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY below,
# or configure an AWS CLI profile (recommended: `aws configure sso`).
AWS_DEFAULT_REGION=ap-south-1

# ── AWS credentials (local dev / CI — not needed in Lambda) ──
# Lambda functions get AWS credentials automatically via their IAM execution role.
# For local development, provide credentials via one of these methods (in order
# of boto3's credential chain):
#   1. Environment variables (this file) — simple for local dev
#   2. AWS CLI profile (~/.aws/credentials) — use `aws configure` or `aws configure sso`
#   3. IAM instance profile — if running on an EC2 instance
#
# NEVER commit real credentials to git or paste them in conversations.
# Use `aws configure sso` with your SSO profile for local development:
#   aws sso login --profile your-profile-name
#   export AWS_PROFILE=your-profile-name
#
# CONSEQUENCE OF WRONG VALUE:
#   botocore.exceptions.NoCredentialsError: Unable to locate credentials
#   botocore.exceptions.ClientError: Access Denied (check IAM policy)
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── S3 ────────────────────────────────────────────────────────
# The S3 bucket where CSV files are uploaded and processed results are stored.
# Created by infrastructure/data.yaml CloudFormation stack.
# The bucket must exist before the API can generate presigned URLs.
#
# KEY STRUCTURE inside the bucket:
#   uploads/{user_id}/{job_id}/original.csv   ← uploaded by browser
#   processed/{user_id}/{job_id}/result.csv   ← written by worker Lambda
#
# CONSEQUENCE OF WRONG VALUE:
#   boto3 will raise NoSuchBucket or AccessDenied when generating presigned URLs.
S3_BUCKET_NAME=csvforge-files-dev

# ── SQS ──────────────────────────────────────────────────────
# The SQS queue URL where the API sends job messages for the worker to consume.
# Created by infrastructure/queues.yaml CloudFormation stack.
# Format: https://sqs.{region}.amazonaws.com/{account-id}/{queue-name}
#
# All resources in ap-south-1 — the queue URL will use ap-south-1.
# Obtain from: aws sqs get-queue-url --queue-name csvforge-jobs-dev --region ap-south-1
#
# CONSEQUENCE OF WRONG VALUE:
#   boto3 will raise QueueDoesNotExist or AccessDenied when enqueueing.
SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/csvforge-jobs-dev

# ── Cognito (Day 4+ — authentication) ────────────────────────
# Required for the frontend to authenticate users via Cognito.
# These values are Outputs from infrastructure/api.yaml CloudFormation stack.
# They are NOT secret — they are public client-side configuration values
# (the User Pool ID and App Client ID are not credentials).
#
# COGNITO_USER_POOL_ID: the User Pool identifier.
#   Format: {region}_{random_chars} (e.g. ap-south-1_AbC123DeF)
#   Obtain from: aws cognito-idp list-user-pools --max-results 10 --region ap-south-1
#   Also available as the CognitoUserPoolId Output from the api.yaml stack.
#
# Used by:
#   - backend/auth.py: constructs the JWT issuer URL for validation context
#   - frontend: amazon-cognito-identity-js InitiateAuth call
COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX

# COGNITO_APP_CLIENT_ID: the App Client identifier (no secret — browser-safe).
#   Format: alphanumeric string (e.g. 1abc2def3ghi4jkl5mno6pqr)
#   Obtain from: aws cognito-idp list-user-pool-clients \
#     --user-pool-id ap-south-1_XXXXXXXXX --region ap-south-1
#   Also available as the CognitoAppClientId Output from the api.yaml stack.
#
# Used by:
#   - frontend: identifies which app is authenticating (included in JWT aud claim)
#   - API Gateway JWT Authoriser: validates the aud claim matches this client
COGNITO_APP_CLIENT_ID=your-app-client-id

# ── API Gateway endpoint (Day 4+ — frontend configuration) ───
# The HTTPS URL of the API Gateway HTTP API created by api.yaml.
# Format: https://{api-id}.execute-api.ap-south-1.amazonaws.com
# Obtain from: aws cloudformation describe-stacks \
#   --stack-name csvforge-api-dev --query "Stacks[0].Outputs" --region ap-south-1
#
# Used by the frontend as the base URL for all API calls.
# In local development, use http://localhost:8000 instead.
API_GATEWAY_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com

# ── CORS (backend) ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins for the CORS middleware.
# Leave unset for local development (defaults to http://localhost:5173).
# Set to the deployed frontend URL in production.
# Format: ALLOWED_ORIGINS=https://your-frontend-bucket.s3-website.ap-south-1.amazonaws.com
#
# Why this matters: The browser enforces the Same-Origin Policy — a page at
# origin A cannot read responses from origin B unless origin B explicitly
# allows it via CORS headers. The FastAPI backend uses CORSMiddleware to add
# those headers. Without the correct origin here, every API call from the
# deployed frontend would be blocked by the browser with a CORS error.
ALLOWED_ORIGINS=http://localhost:5173
