# CSVForge Frontend — environment variables template
#
# HOW TO USE:
#   cp .env.example .env.local
#   Edit .env.local with your actual values.
#   .env.local is gitignored (never commit it).
#
# VITE_ PREFIX:
#   Only variables prefixed with VITE_ are exposed to the browser bundle.
#   Variables WITHOUT the prefix are only available in vite.config.ts (Node).
#   This prevents accidentally exposing server-side secrets.
#   Note: VITE_ variables ARE visible in the browser — never put secret values here.
#
# THREE ENVIRONMENTS:
#
#   LOCAL DEV (no Cognito deployed):
#     VITE_COGNITO_USER_POOL_ID=        (empty — triggers local dev bypass)
#     VITE_COGNITO_APP_CLIENT_ID=       (empty)
#     VITE_API_URL=http://localhost:8000
#
#   LOCAL DEV (with real Cognito):
#     VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
#     VITE_COGNITO_APP_CLIENT_ID=your-app-client-id
#     VITE_API_URL=http://localhost:8000
#
#   PRODUCTION (deployed):
#     VITE_COGNITO_USER_POOL_ID=ap-south-1_XXXXXXXXX
#     VITE_COGNITO_APP_CLIENT_ID=your-app-client-id
#     VITE_API_URL=https://your-api-id.execute-api.ap-south-1.amazonaws.com

# ── API ───────────────────────────────────────────────────────────────────────
# Base URL for all API calls. No trailing slash.
VITE_API_URL=http://localhost:8000

# ── Cognito ───────────────────────────────────────────────────────────────────
# Leave BOTH empty to enable local dev bypass (no Cognito needed).
# Set BOTH to real values for Cognito authentication.
# These are NOT secrets — they are public client-side identifiers.
# Obtain from CloudFormation Outputs after deploying infrastructure/api.yaml.
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_APP_CLIENT_ID=

# ── AWS Region (informational — not used by frontend code directly) ────────────
# All CSVForge resources are in ap-south-1. Documented here for context.
# The Cognito User Pool ID encodes the region (e.g., ap-south-1_XXXXXXXXX).
VITE_AWS_REGION=ap-south-1
