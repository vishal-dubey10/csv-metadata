{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3InputRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::csvforge-files-dev/uploads/*"
    },
    {
      "Sid": "S3OutputWrite",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::csvforge-files-dev/processed/*"
    },
    {
      "Sid": "SQSProcessing",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:ap-south-1:*:csvforge-jobs-dev"
    },
    {
      "Sid": "CloudWatchLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:ap-south-1:*:log-group:/aws/lambda/csvforge-worker-dev:*"
    }
  ]
}
